@article{HoelKarp2002,
    copyright = {2002 Elsevier Science B.V.},
    language = {eng},
    address = {Amsterdam},
    author = {Hoel, Michael and Karp, Larry},
    keywords = {Abatement ; Applied sciences ; Asymmetric and Private Information Mechanism Design (D82) ; Asymmetric Information ; Damages ; Economic models ; Economic theory ; Economics ; Exact sciences and technology ; Global ; Global environmental pollution ; Greenhouse gas ; Information ; Information asymmetry ; Marginal abatement cost ; Natural resource economics ; Pollutant ; Polluter ; Pollution ; Pollution control ; Pollution control costs ; Pollution prevention ; Public economics ; Quotas ; Renewable Resources and Conservation: Government Policy (Q28) ; Renewable Resources and Conservation: Water (Q25) ; Stochastic control ; Stochastic models ; Stock (geology) ; Studies ; Tax ; Tax deferral ; Taxation and Subsidies: Externalities Redistributive Effects Environmental Taxes and Subsidies (H23) ; Taxes ; Taxes and quotas},
    issn = {0928-7655},
    abstract = {We compare the effects of taxes and quotas for an environmental problem where the regulator and polluter have asymmetric information about abatement costs, and environmental damage depends on pollution stock. An increase in the slope of the marginal abatement cost curve, or a decrease in the slope of the marginal damage curve, favors taxes. An increase in the discount rate or the stock decay rate favors tax usage. Taxes dominate quotas if the length of a period during which decisions are constant is sufficiently small. An empirical illustration suggests that taxes dominate quotas for the control of greenhouse gasses.},
    journal = {Resource and energy economics},
    pages = {367--384},
    volume = {24},
    publisher = {Elsevier B.V},
    number = {4},
    year = {2002},
    title = {Taxes versus quotas for a stock pollutant},
}

@article{KarpZhang2012,
    copyright = {Springer-Verlag Berlin Heidelberg 2012},
    language = {eng},
    address = {Berlin/Heidelberg},
    author = {Karp, Larry and Zhang, Jiangfeng},
    keywords = {Asymmetric and Private Information Mechanism Design (D82) ; Asymmetric Information ; Capital Budgeting Fixed Investment and Inventory Studies Capacity (G31) ; Capital costs ; Choice of instruments ; Climate change ; Climate Natural Disasters and Their Management Global Warming (Q54) ; Commercial regulation ; Decision-making ; Deterrence ; Development banks ; Economic theory ; Economic Theory/Quantitative Economics/Mathematical Methods ; Economics ; Economics and Finance ; Emission charges ; Emissions ; Emissions policy ; Emissions regulations ; Energy tax ; Environmental economics ; Environmental Economics: Government Policy (Q58) ; Equilibrium ; Externalities (Economics) ; Financial regulation ; Firm ; Game Theory ; Greenhouse effect ; Information ; Information asymmetry ; Investment ; Investment (macroeconomics) ; Investment decisions ; Investment Policy ; Investment tax credits ; Investments ; Markov analysis ; Markov perfect equilibrium ; Microeconomics ; Optimal taxation ; Pollutant emissions ; Pollutants ; Pollution control ; Price ceilings ; Public Finance ; Quotas ; Rational expectations ; Sales tax ; Social and Behav. Sciences ; Studies ; Symposium ; Tax ; Taxation ; Taxation and Subsidies: Externalities Redistributive Effects Environmental Taxes and Subsidies (H23) ; Taxes ; Use tax},
    issn = {0938-2259},
    abstract = {We compare emissions taxes and quotas when a (strategic) regulator and (non-strategic) firms have asymmetric information about abatement costs, and all agents use Markov perfect decision rules. Firms make investment decisions that affect their future abatement costs. For general functional forms, firms' investment policy is information-constrained efficient when the regulator uses a quota, but not when the regulator uses an emissions tax. This advantage of quotas over emissions taxes has not previously been recognized. For a special functional form (linear-quadratic) both policies are constrained efficient. Using numerical methods, we find that a tax has some advantages in this case.},
    journal = {Economic theory},
    pages = {371--409},
    volume = {49},
    publisher = {Springer},
    number = {2},
    year = {2012},
    title = {Taxes versus quantities for a stock pollutant with endogenous abatement costs and asymmetric information},
}

@article{Golosov2014etal,
    copyright = {Copyright ©2014 The Econometric Society},
    language = {eng},
    address = {Oxford, UK},
    author = {Golosov, Mikhail and Hassler, John and Krusell, Per and Tsyvinski, Aleh},
    keywords = {Carbon ; Carbon dioxide emissions ; Carbon taxes ; Climate ; Climate change ; Climate models ; Climate Natural Disasters and Their Management Global Warming (Q54) ; Coal ; Econometrics ; Endogenous ; Energy ; Energy Sources ; Energy: Demand and Supply Prices (Q41) ; Environmental Economics: Government Policy (Q58) ; Environmental tax ; Externality ; Fossil fuels ; Fuel ; Gasoline taxes ; General economic equilibrium ; Gross domestic product ; Laissez faire ; Mining Extraction and Refining: Hydrocarbon Fuels (L71) ; Nonrenewable Resources and Conservation: Demand and Supply Prices (Q31) ; Oil ; optimal policy ; Optimal taxation ; optimal taxes ; Stochastic models ; Stochastic processes ; Studies ; Tax ; Taxation and Subsidies: Efficiency Optimal Taxation (H21) ; Taxation and Subsidies: Externalities Redistributive Effects Environmental Taxes and Subsidies (H23) ; Taxes ; Value added taxes ; Welfare economics},
    issn = {0012-9682},
    abstract = {We analyze a dynamic stochastic general-equilibrium (DSGE) model with an externality—through climate change—from using fossil energy. Our central result is a simple formula for the marginal externality damage of emissions (or, equivalently, for the optimal carbon tax). This formula, which holds under quite plausible assumptions, reveals that the damage is proportional to current GDP, with the proportion depending only on three factors: (i) discounting, (ii) the expected damage elasticity (how many percent of the output flow is lost from an extra unit of carbon in the atmosphere), and (iii) the structure of carbon depreciation in the atmosphere. Thus, the stochastic values of future output, consumption, and the atmospheric CO 2 concentration, as well as the paths of technology (whether endogenous or exogenous) and population, and so on, all disappear from the formula. We find that the optimal tax should be a bit higher than the median, or most well-known, estimates in the literature. We also formulate a parsimonious yet comprehensive and easily solved model allowing us to compute the optimal and market paths for the use of different sources of energy and the corresponding climate change. We find coal—rather than oil—to be the main threat to economic welfare, largely due to its abundance. We also find that the costs of inaction are particularly sensitive to the assumptions regarding the substitutability of different energy sources and technological progress.},
    journal = {Econometrica},
    pages = {41--88},
    volume = {82},
    publisher = {Econometric Society},
    number = {1},
    year = {2014},
    title = {Optimal taxes on fossil fuel in general equilibrium},
}

